[Unit]
Description=Holiday Blackbox UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blackbox
WorkingDirectory=/home/blackbox/Holiday-blackbox/Software
ExecStart=/home/blackbox/Holiday-blackbox/Software/venv/bin/python -m blackbox.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

